root   ::= object
object ::= "{\n" pairs "\n}"
pairs  ::= pair (",\n" pair)*
pair   ::= "  \"" id "\": {\n" node_body "\n  }"

node_body ::= "    \"class_type\": " string ",\n    \"inputs\": {\n" inputs "\n    }"

inputs ::= input (",\n" input)* | ""
input  ::= "      \"" name "\": " value

value  ::= string | number | connection
connection ::= "[\"" id "\", " [0-9] "]"

id     ::= [0-9]+
name   ::= [a-zA-Z0-9_]+
string ::= "\"" [^"\\]* "\""
number ::= "-"? [0-9]+ ("." [0-9]+)?
